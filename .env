# Copy this file to .env and adjust if needed. On Windows, running
# manage.py directly (not inside Docker) needs POSTGRES_HOST=localhost —
# Docker Compose maps the db container's 5432 to your machine's 5432.

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=beprc_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=beprc123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
